# Server port
PORT=5000

# MongoDB connection string (MongoDB Atlas or local)
# Local:  mongodb://localhost:27017/multiplayer-wordle
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/multiplayer-wordle
MONGODB_URI=mongodb://localhost:27017/multiplayer-wordle

# URL of the deployed React frontend (used for CORS)
# Local dev: http://localhost:5173
# Production: https://your-frontend.vercel.app
CLIENT_URL=http://localhost:5173

# Node environment: development | production
NODE_ENV=development

# How long to keep rooms alive (in minutes) before cleaning them up
ROOM_EXPIRATION_MINUTES=60

# Rate limiting for guess submissions (per socket)
# Window in milliseconds
GUESS_RATE_LIMIT_WINDOW_MS=2000
# Max guesses allowed per window
GUESS_RATE_LIMIT_MAX=2
